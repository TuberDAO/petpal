# Supabase Configuration
# Get these from your Supabase project settings

# Public URL - safe to expose to client
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# Anon key - safe to expose to client (has RLS restrictions)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service role key - NEVER expose to client, server-side only
# This bypasses RLS and should only be used in API routes
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
